@model IEnumerable<dynamic>
@using NMBDHL.Doctor.Model

@{
    // Dynamically calculate urgency distribution for the new visual chart based on recent requests
    var recentReqs = ViewBag.RecentRequests as IEnumerable<RecentRequestModel> ?? new List<RecentRequestModel>();
    int statCount = recentReqs.Count(r => r.Urgency == "STAT");
    int urgentCount = recentReqs.Count(r => r.Urgency == "Urgent");
    int routineCount = recentReqs.Count(r => r.Urgency == "Routine");
    int totalReqs = statCount + urgentCount + routineCount;
    if (totalReqs == 0) totalReqs = 1; // Prevent division by zero

    int statPercent = (int)Math.Round((double)statCount / totalReqs * 100);
    int urgentPercent = (int)Math.Round((double)urgentCount / totalReqs * 100);
    int routinePercent = 100 - statPercent - urgentPercent; // Ensure it equals 100%
}

<div class="container-fluid p-4 text-start animate-fade-in" style="background-color: #ffffff;">
    <div class="mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-dark mb-1">Clinical Operations Dashboard</h2>
        <p class="text-muted m-0 small">Real-time surveillance matrix for patient parameters and laboratory throughput.</p>
    </div>

    <!-- TOP KPI METRICS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Active Requisitions</div>
                        <div class="fs-3 fw-bold text-dark">@ViewBag.TotalActiveRequests</div>
                    </div>
                    <div class="bg-primary-subtle rounded-3 p-2 text-primary"><i class="fa-solid fa-vials fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px; border-left: 4px solid #ef4444 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Critical Alerts (5d)</div>
                        <div class="fs-3 fw-bold text-danger">@ViewBag.CriticalAlertsCount</div>
                    </div>
                    <div class="bg-danger-subtle rounded-3 p-2 text-danger"><i class="fa-solid fa-triangle-exclamation fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Pending Collections</div>
                        <div class="fs-3 fw-bold text-dark">@ViewBag.PendingCollections</div>
                    </div>
                    <div class="bg-warning-subtle rounded-3 p-2 text-warning"><i class="fa-solid fa-box-tissue fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Turnaround Compliance</div>
                        <div class="fs-3 fw-bold text-success">@ViewBag.TurnaroundCompliance</div>
                    </div>
                    <div class="bg-success-subtle rounded-3 p-2 text-success"><i class="fa-solid fa-clock-check fa-lg"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- MIDDLE ROW: VISUAL CHARTS -->
    <div class="row g-4 mb-4">

        <!-- DIAGNOSTIC PIPELINE DISTRIBUTION -->
        <div class="col-xl-8">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 14px;">
                <div class="card-header bg-transparent border-0 pt-3 px-4">
                    <h5 class="fw-bold text-dark m-0"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Diagnostic Pipeline Analytics</h5>
                    <p class="text-muted small mt-1 mb-0">Real-time volume distribution of all active diagnostic orders across the laboratory network.</p>
                </div>

                <div class="card-body px-4 py-3">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <!-- Submitted -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold text-secondary">Awaiting Logistics (Submitted)</span>
                                    <span class="fw-bold text-dark">@ViewBag.SubmittedCount</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 8px;">
                                    <div class="progress-bar bg-info" style="width: @(ViewBag.SubmittedCount * 8)%"></div>
                                </div>
                            </div>

                            <!-- Samples Received -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold text-secondary">Specimens Received</span>
                                    <span class="fw-bold text-dark">@ViewBag.SamplesReceivedCount</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 8px;">
                                    <div class="progress-bar bg-primary" style="width: @(ViewBag.SamplesReceivedCount * 8)%"></div>
                                </div>
                            </div>

                            <!-- In Progress -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold text-secondary">Analysis In Progress</span>
                                    <span class="fw-bold text-dark">@ViewBag.InProgressCount</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 8px;">
                                    <div class="progress-bar bg-warning" style="width: @(ViewBag.InProgressCount * 8)%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- Completed -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold text-secondary">Verification Completed</span>
                                    <span class="fw-bold text-dark">@ViewBag.CompletedCount</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 8px;">
                                    <div class="progress-bar bg-success" style="width: @(ViewBag.CompletedCount * 8)%"></div>
                                </div>
                            </div>

                            <!-- Released -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold text-secondary">Released to Patient</span>
                                    <span class="fw-bold text-dark">@ViewBag.ReleasedCount</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 8px;">
                                    <div class="progress-bar" style="background-color: #8b5cf6; width: @(ViewBag.ReleasedCount * 8)%"></div>
                                </div>
                            </div>

                            <!-- Cancelled -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold text-secondary">Voided / Cancelled</span>
                                    <span class="fw-bold text-dark">@ViewBag.CancelledCount</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 8px;">
                                    <div class="progress-bar bg-danger opacity-75" style="width: @(ViewBag.CancelledCount * 8)%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- NEW: URGENCY PRIORITY MATRIX -->
        <div class="col-xl-4">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 14px;">
                <div class="card-header bg-transparent border-0 pt-3 px-4">
                    <h5 class="fw-bold text-dark m-0"><i class="fa-solid fa-layer-group text-primary me-2"></i>Urgency Priority Matrix</h5>
                    <p class="text-muted small mt-1 mb-0">Throughput volume by clinical urgency tier.</p>
                </div>
                <div class="card-body px-4 d-flex flex-column justify-content-center">

                    <div class="progress mb-4 shadow-sm" style="height: 24px; border-radius: 12px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @statPercent%" title="STAT: @statPercent%"></div>
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @urgentPercent%" title="Urgent: @urgentPercent%"></div>
                        <div class="progress-bar bg-info" role="progressbar" style="width: @routinePercent%" title="Routine: @routinePercent%"></div>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center p-2 border rounded-3 bg-light-subtle">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #dc3545;"></div>
                                <span class="small fw-semibold text-dark">STAT (Immediate)</span>
                            </div>
                            <span class="badge bg-danger-subtle text-danger">@statPercent%</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2 border rounded-3 bg-light-subtle">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #ffc107;"></div>
                                <span class="small fw-semibold text-dark">Urgent (Priority)</span>
                            </div>
                            <span class="badge bg-warning-subtle text-warning-emphasis">@urgentPercent%</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2 border rounded-3 bg-light-subtle">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #0dcaf0;"></div>
                                <span class="small fw-semibold text-dark">Routine (Standard)</span>
                            </div>
                            <span class="badge bg-info-subtle text-info-emphasis">@routinePercent%</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- BOTTOM ROW: ALERTS AND RECENT WORKSTREAM -->
    <div class="row g-4">

        <!-- CRITICAL ABNORMAL FLAGS -->
        <div class="col-xl-5">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 14px;">
                <div class="card-header bg-transparent border-0 pt-3 px-4">
                    <h5 class="fw-bold text-danger m-0"><i class="fa-solid fa-bell me-2"></i>Abnormal Critical Flags</h5>
                    <p class="text-muted small mt-1 mb-0">Results requiring immediate clinical attention.</p>
                </div>

                <div class="card-body px-4">
                    <div class="d-flex flex-column gap-3 mb-3">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var alert in Model)
                            {
                                string alertLevel = alert.AlertLevel != null ? alert.AlertLevel.ToString() : "";
                                var badgeClass = alertLevel.Contains("High") ? "bg-danger text-white" : "bg-warning text-dark";
                                <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle position-relative" style="transition: transform 0.2s;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold text-dark m-0">@alert.Surname, @alert.FirstName</h6>
                                            <small class="text-muted font-monospace">ID: @alert.IdNumber</small>
                                        </div>
                                        <span class="badge @badgeClass fw-semibold text-uppercase small">@alertLevel</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top border-light-subtle mb-2">
                                        <div>
                                            <small class="text-secondary d-block">@alert.TestName</small>
                                            <strong class="text-dark fs-5">@alert.ResultValue <span class="small text-muted fs-6">@alert.Unit</span></strong>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-secondary-subtle text-secondary font-monospace small mb-1 d-block">@alert.RefRange</span>
                                            <small class="text-muted d-block" style="font-size: 0.75rem;"><i class="fa-regular fa-clock me-1"></i>@alert.Date</small>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2 pt-1">
                                        <button class="btn btn-sm btn-primary fw-semibold px-3 w-100" data-bs-toggle="modal" data-bs-target="#releaseModal" onclick="setupReleaseModal(13, '@alert.Surname, @alert.FirstName', '@alert.TestName', '@alert.ResultValue @alert.Unit')" style="font-size: 0.78rem; border-radius: 6px; background-color: #0284c7; border-color: #0284c7;">
                                            <i class="fa-solid fa-share-from-square me-1"></i>Review & Release
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center border rounded-3 bg-light-subtle mt-2">
                                <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="fa-solid fa-shield-heart fs-3 text-success"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">All Clear</h6>
                                <p class="mb-0 text-muted small">No critical abnormal alerts detected in the current verification batch.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RECENT WORKSTREAM TABLE -->
        <div class="col-xl-7">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 14px;">
                <div class="card-header bg-transparent border-0 pt-3 ps-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark m-0"><i class="fa-solid fa-list-check text-primary me-2"></i>Recent Workstream Requests</h5>
                        <p class="text-muted small mt-1 mb-0">Live tracking of most recently dispatched diagnostic orders.</p>
                    </div>
                    <button class="btn btn-sm btn-light border text-primary fw-semibold me-3" onclick="loadSection('trackprogress')">View All</button>
                </div>
                <div class="card-body p-0 mt-2">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover m-0">
                            <thead class="bg-light text-secondary small uppercase">
                                <tr>
                                    <th class="ps-4">Request Ref</th>
                                    <th>Patient Profile</th>
                                    <th>Urgency</th>
                                    <th>Vector Status</th>
                                    <th class="pe-4 text-end">Updated</th>
                                </tr>
                            </thead>
                            <tbody class="text-dark small border-top-0">
                                @if (ViewBag.RecentRequests != null && ((IEnumerable<dynamic>)ViewBag.RecentRequests).Any())
                                {
                                    foreach (var req in ViewBag.RecentRequests)
                                    {
                                        var urgencyBadge = req.Urgency == "STAT" ? "bg-danger-subtle text-danger" : req.Urgency == "Urgent" ? "bg-warning-subtle text-warning-emphasis" : "bg-info-subtle text-info-emphasis";
                                        <tr>
                                            <td class="ps-4 font-monospace fw-semibold text-primary">@req.RequestNumber</td>
                                            <td>
                                                <div class="fw-bold">@req.PatientName</div>
                                                <small class="text-muted font-monospace" style="font-size: 0.72rem;">@req.IdNumber</small>
                                            </td>
                                            <td><span class="badge @urgencyBadge px-2 py-1 fw-semibold">@req.Urgency</span></td>
                                            <td><span class="badge bg-light text-dark border border-light-subtle px-2 py-1 shadow-sm">@req.Status</span></td>
                                            <td class="pe-4 text-end text-muted">@req.TimeElapsed</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-5">
                                            <i class="fa-solid fa-folder-open fs-2 mb-3 text-light-subtle"></i>
                                            <div class="fw-medium">No recent laboratory requisitions found.</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
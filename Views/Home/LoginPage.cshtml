@model NMBDHL.Auth.Model.Login

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Page</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
            html, body {
                min-height: 100%;
                margin: 0;
                background-color: #071D37;
                font-family: Arial, sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 30px 15px;
                box-sizing: border-box;
            }

            .top-left-nav {
                position: fixed;
                top: 20px;
                left: 20px;
                z-index: 10;
            }

            .nav-icon-group {
                display: flex;
                gap: 12px;
                align-items: center;
                padding: 10px 14px;
                border: 2px solid white;
                border-radius: 12px;
                text-decoration: none;
                color: white;
            }

                .nav-icon-group:hover {
                    background: rgba(255,255,255,0.1);
                    color: white;
                }

            .login-card {
                width: 900px;
                max-width: 100%;
                min-height: 550px;
                display: flex;
                border-radius: 24px;
                overflow: hidden;
                background: white;
                box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            }

            .login-left {
                width: 50%;
                background-image: url('@Url.Content("~/pictures/logo.png")');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-color: #f5f7fa;
            }

            .login-right {
                width: 50%;
                padding: 45px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .login-title {
                font-weight: 700;
                color: #071D37;
                text-align: center;
                margin-bottom: 30px;
            }

            .form-label {
                color: #071D37;
                font-weight: 600;
            }

            .form-control,
            .form-select {
                min-height: 44px;
            }

            .btn-primary {
                background-color: #071D37;
                border-color: #071D37;
            }

                .btn-primary:hover {
                    background-color: #12365e;
                    border-color: #12365e;
                }

            .register-link {
                color: #0d6efd;
                font-weight: 600;
                text-decoration: none;
                cursor: pointer;
            }

                .register-link:hover {
                    text-decoration: underline;
                }

            .modal-overlay {
                display: none;
                position: fixed;
                inset: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.65);
                justify-content: center;
                align-items: center;
                padding: 20px;
                z-index: 1000;
                overflow-y: auto;
            }

            .modal-box {
                width: 95%;
                max-width: 1050px;
                max-height: 90vh;
                overflow-y: auto;
                padding: 35px 45px;
                background: #fff;
                border-radius: 16px;
                box-shadow: 0 10px 35px rgba(0,0,0,0.25);
                box-sizing: border-box;
                margin: auto;
            }

                .modal-box h5 {
                    font-size: 1.4rem;
                    font-weight: 700;
                    color: #071D37;
                }

                .modal-box .row {
                    --bs-gutter-x: 32px;
                    --bs-gutter-y: 8px;
                }

                .modal-box .form-label {
                    display: block;
                    margin-bottom: 7px;
                    font-weight: 600;
                }

                .modal-box .form-control,
                .modal-box .form-select {
                    min-height: 46px;
                    padding: 10px 13px;
                    border-radius: 7px;
                }

                .modal-box .btn-primary {
                    min-height: 46px;
                    margin-top: 10px;
                }

            .validation-message {
                display: block;
                min-height: 18px;
                margin-top: 5px;
                font-size: 0.82rem;
            }

            .form-control.is-valid,
            .form-select.is-valid {
                border-color: #198754;
                background-color: #f8fff9;
            }

            .form-control.is-invalid,
            .form-select.is-invalid {
                border-color: #dc3545;
                background-color: #fffafa;
            }

            .validation-message.valid {
                color: #198754;
            }

            .validation-message.invalid {
                color: #dc3545;
            }

            .address-note {
                color: #6c757d;
                font-size: 0.82rem;
                margin-top: 4px;
            }

            @@media (max-width: 700px) {
                body {
                    padding: 80px 12px 20px;
                }

                .login-card {
                    width: 450px;
                    min-height: auto;
                }

                .login-left {
                    display: none;
                }

                .login-right {
                    width: 100%;
                    padding: 35px 25px;
                }

                .modal-overlay {
                    padding: 10px;
                    align-items: flex-start;
                }

                .modal-box {
                    width: 100%;
                    max-width: 100%;
                    max-height: 95vh;
                    padding: 24px 20px;
                }

                    .modal-box .row {
                        --bs-gutter-x: 16px;
                    }
            }
    </style>
</head>

<body>

    <!-- HOME NAVIGATION -->
    <div class="top-left-nav">
        <a asp-controller="Home" asp-action="Index" class="nav-icon-group">
            <i class="fa-solid fa-arrow-left"></i>
            <i class="fa-solid fa-house"></i>
        </a>
    </div>

    <!-- LOGIN CARD -->
    <div class="login-card">
        <div class="login-left"></div>

        <div class="login-right">
            <h2 class="login-title">Login</h2>

            @if (TempData["RegistrationSuccess"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["RegistrationSuccess"]
                </div>
            }

            <form asp-controller="Home" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="ReturnUrl" value="@Model?.ReturnUrl" />

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.Message
                    </div>
                }

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email address"
                           autocomplete="username"
                           required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>

                    <div class="input-group">
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               id="passwordInput"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <button class="btn btn-outline-secondary"
                                type="button"
                                onclick="togglePassword()"
                                aria-label="Show or hide password">
                            <i class="fa-solid fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberLogin" class="form-check-input" />
                    <label asp-for="RememberLogin" class="form-check-label">
                        Remember me
                    </label>
                </div>

                <div class="d-flex justify-content-center mt-3">
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="fa-solid fa-right-to-bracket"></i> Login
                    </button>
                </div>

                <div class="text-center mt-3">
                    <button type="button"
                            class="register-link btn btn-link p-0"
                            onclick="openRegisterModal()">
                        <i class="fa-solid fa-person-circle-plus"></i> Register
                    </button>
                </div>

                <div class="text-center mt-3">
                    <button type="button"
                            class="register-link btn btn-link p-0"
                            onclick="openForgotModal()">
                        <i class="fa-solid fa-circle-question"></i> Forgot Password?
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- PATIENT REGISTRATION MODAL -->
    <div id="registerModal" class="modal-overlay">
        <div class="modal-box">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="mb-1">Patient Registration</h5>
                    <small class="text-muted">Enter the patient's details below.</small>
                </div>

                <button type="button"
                        class="btn-close"
                        onclick="closeRegisterModal()"
                        aria-label="Close"></button>
            </div>

            <form id="registerForm"
                  asp-controller="Home"
                  asp-action="RegisterPatient"
                  method="post">
                @Html.AntiForgeryToken()

                @if (ViewBag.RegisterMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.RegisterMessage
                    </div>
                }

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="regName">Name</label>
                        <input type="text"
                               id="regName"
                               name="Name"
                               class="form-control"
                               minlength="2"
                               maxlength="100"
                               autocomplete="given-name"
                               data-validation="name"
                               required />
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="regSurname">Surname</label>
                        <input type="text"
                               id="regSurname"
                               name="Surname"
                               class="form-control"
                               minlength="2"
                               maxlength="100"
                               autocomplete="family-name"
                               data-validation="name"
                               required />
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="IDNumber">
                            South African ID Number
                        </label>
                        <input type="text"
                               id="IDNumber"
                               name="IDNumber"
                               class="form-control"
                               maxlength="13"
                               minlength="13"
                               inputmode="numeric"
                               pattern="[0-9]{13}"
                               data-validation="id"
                               autocomplete="off"
                               required />
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="DateOfBirth">Date of Birth</label>
                        <input type="date"
                               id="DateOfBirth"
                               name="DateOfBirth"
                               class="form-control"
                               autocomplete="bday"
                               data-validation="dob"
                               readonly
                               required />
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="Cellphone">Cellphone Number</label>
                        <input type="tel"
                               id="Cellphone"
                               name="Cellphone"
                               class="form-control"
                               placeholder="e.g. 0821234567"
                               maxlength="12"
                               autocomplete="tel"
                               data-validation="phone"
                               required />
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="regEmail">Email (Username)</label>
                        <input type="email"
                               id="regEmail"
                               name="Email"
                               class="form-control"
                               maxlength="254"
                               autocomplete="email"
                               data-validation="email"
                               required />
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="StreetAddress">Street Address</label>
                        <input type="text"
                               id="StreetAddress"
                               name="StreetAddress"
                               class="form-control"
                               placeholder="House number and street"
                               maxlength="200"
                               autocomplete="address-line1"
                               data-validation="required"
                               required />
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="Province">Province</label>
                        <select id="Province"
                                name="Province"
                                class="form-select"
                                autocomplete="address-level1"
                                data-validation="address"
                                required>
                            <option value="">Select Province</option>
                        </select>
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="City">City / Town</label>
                        <select id="City"
                                name="City"
                                class="form-select"
                                autocomplete="address-level2"
                                data-validation="address"
                                disabled
                                required>
                            <option value="">Select City / Town</option>
                        </select>
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="Suburb">Suburb</label>
                        <select id="Suburb"
                                name="Suburb"
                                class="form-select"
                                autocomplete="address-level3"
                                data-validation="address"
                                disabled
                                required>
                            <option value="">Select Suburb</option>
                        </select>
                        <small class="validation-message"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="PostalCode">Postal Code</label>
                        <input type="text"
                               id="PostalCode"
                               name="PostalCode"
                               class="form-control"
                               maxlength="4"
                               minlength="4"
                               inputmode="numeric"
                               pattern="[0-9]{4}"
                               autocomplete="postal-code"
                               data-validation="postal"
                               readonly
                               required />
                        <small class="validation-message"></small>
                        <div class="address-note">
                            Automatically populated from the selected suburb.
                        </div>
                    </div>

                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-user-plus"></i> Register Patient
                </button>
            </form>
        </div>
    </div>

    <!-- FORGOT PASSWORD: SEARCH EMAIL -->
    <div id="forgotModal" class="modal-overlay">
        <div class="modal-box" style="max-width: 550px;">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Forgot Password</h5>

                <button type="button"
                        class="btn-close"
                        onclick="closeForgotModal()"
                        aria-label="Close"></button>
            </div>

            <p>Enter the email address registered to your account.</p>

            <form asp-controller="Home"
                  asp-action="FindUserByEmail"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" for="searchEmail">Email Address</label>
                    <input type="email"
                           id="searchEmail"
                           name="Email"
                           class="form-control"
                           value="@Model?.Email"
                           placeholder="Enter your email"
                           required />
                </div>

                @if (ViewBag.ForgotMessage != null)
                {
                    <div class="text-danger small mb-3" role="alert">
                        @ViewBag.ForgotMessage
                    </div>
                }

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-magnifying-glass"></i> Search
                </button>
            </form>
        </div>
    </div>

    <!-- SEND PASSWORD RESET LINK -->
    <div id="sendLinkModal" class="modal-overlay">
        <div class="modal-box" style="max-width: 550px;">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Send Password Reset Link</h5>

                <button type="button"
                        class="btn-close"
                        onclick="closeSendLinkModal()"
                        aria-label="Close"></button>
            </div>

            <p>A password-reset link will be sent to this registered email address.</p>

            <form asp-controller="Home"
                  asp-action="ForgotPassword"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" for="registeredEmail">Registered Email</label>
                    <input type="email"
                           id="registeredEmail"
                           name="Email"
                           class="form-control"
                           value="@ViewBag.RegisteredEmail"
                           readonly
                           required />
                </div>

                @if (ViewBag.SendLinkMessage != null)
                {
                    <div class="text-danger small mb-3" role="alert">
                        @ViewBag.SendLinkMessage
                    </div>
                }

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-envelope"></i> Send Link to Email
                </button>
            </form>
        </div>
    </div>


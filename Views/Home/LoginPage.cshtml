            // =========================================================
            // PASSWORD VISIBILITY
            // =========================================================

            function togglePassword() {
                const input = document.getElementById("passwordInput");
                const icon = document.getElementById("eyeIcon");

                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.replace("fa-eye", "fa-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.replace("fa-eye-slash", "fa-eye");
                }
            }

            // =========================================================
            // MODAL CONTROLS
            // =========================================================

            function openRegisterModal() {
                document.getElementById("registerModal").style.display = "flex";
            }

            function closeRegisterModal() {
                document.getElementById("registerModal").style.display = "none";
            }

            function openForgotModal() {
                document.getElementById("forgotModal").style.display = "flex";
            }

            function closeForgotModal() {
                document.getElementById("forgotModal").style.display = "none";
            }

            function closeSendLinkModal() {
                document.getElementById("sendLinkModal").style.display = "none";
            }

            document.querySelectorAll(".modal-overlay").forEach(function(overlay) {
                overlay.addEventListener("click", function(event) {
                    if (event.target === overlay) {
                        overlay.style.display = "none";
                    }
                });
            });

            document.addEventListener("keydown", function(event) {
                if (event.key === "Escape") {
                    closeRegisterModal();
                    closeForgotModal();
                    closeSendLinkModal();
                }
            });

            // =========================================================
            // CASCADING ADDRESS DROPDOWNS
            // =========================================================

            document.addEventListener("DOMContentLoaded", function() {
                const provinceSelect = document.getElementById("Province");
                const citySelect = document.getElementById("City");
                const suburbSelect = document.getElementById("Suburb");
                const postalCodeInput = document.getElementById("PostalCode");

                if (!provinceSelect || !citySelect || !suburbSelect || !postalCodeInput) {
                    return;
                }

                function setFieldResult(field, error) {
                    const container = field.closest(".mb-3");
                    const message = container
                        ? container.querySelector(".validation-message")
                        : null;

                    field.classList.toggle("is-invalid", Boolean(error));
                    field.classList.toggle(
                        "is-valid",
                        !error && field.value.trim() !== ""
                    );

                    if (message) {
                        message.textContent = error ||
                            (field.value.trim() ? "Looks good." : "");

                        message.classList.toggle("invalid", Boolean(error));
                        message.classList.toggle(
                            "valid",
                            !error && field.value.trim() !== ""
                        );
                    }
                }

                function resetSelect(select, placeholder) {
                    select.replaceChildren();

                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = placeholder;
                    select.appendChild(option);

                    select.disabled = true;
                    select.classList.remove("is-valid", "is-invalid");

                    const message = select.closest(".mb-3")
                        ?.querySelector(".validation-message");

                    if (message) {
                        message.textContent = "";
                        message.classList.remove("valid", "invalid");
                    }
                }

                function addOption(select, value, label) {
                    const option = document.createElement("option");
                    option.value = value;
                    option.textContent = label;
                    select.appendChild(option);
                }

                Object.keys(addressData).sort().forEach(function(province) {
                    addOption(provinceSelect, province, province);
                });

                provinceSelect.addEventListener("change", function() {
                    resetSelect(citySelect, "Select City / Town");
                    resetSelect(suburbSelect, "Select Suburb");
                    postalCodeInput.value = "";

                    const province = provinceSelect.value;

                    if (!province || !addressData[province]) {
                        validateAddressField(provinceSelect);
                        return;
                    }

                    Object.keys(addressData[province]).sort().forEach(function(city) {
                        addOption(citySelect, city, city);
                    });

                    citySelect.disabled = false;
                    validateAddressField(provinceSelect);
                });

                citySelect.addEventListener("change", function() {
                    resetSelect(suburbSelect, "Select Suburb");
                    postalCodeInput.value = "";

                    const province = provinceSelect.value;
                    const city = citySelect.value;

                    if (!province || !city || !addressData[province]?.[city]) {
                        validateAddressField(citySelect);
                        return;
                    }

                    Object.keys(addressData[province][city]).sort().forEach(function(suburb) {
                        addOption(suburbSelect, suburb, suburb);
                    });

                    suburbSelect.disabled = false;
                    validateAddressField(citySelect);
                });

                suburbSelect.addEventListener("change", function() {
                    postalCodeInput.value = "";

                    const province = provinceSelect.value;
                    const city = citySelect.value;
                    const suburb = suburbSelect.value;

                    if (!province || !city || !suburb) {
                        validateAddressField(suburbSelect);
                        validateAddressField(postalCodeInput);
                        return;
                    }

                    const address = addressData[province]?.[city]?.[suburb];

                    if (address) {
                        postalCodeInput.value = address.street;
                    }

                    validateAddressField(suburbSelect);
                    validateAddressField(postalCodeInput);
                });

                function validateAddressField(field) {
                    let error = "";

                    if (!field.value) {
                        error = "Please select an option.";
                    } else if (field.id === "Province") {
                        if (!addressData[field.value]) {
                            error = "Select a valid configured province.";
                        }
                    } else if (field.id === "City") {
                        const province = provinceSelect.value;

                        if (!addressData[province]?.[field.value]) {
                            error = "Select a valid city for the chosen province.";
                        }
                    } else if (field.id === "Suburb") {
                        const province = provinceSelect.value;
                        const city = citySelect.value;

                        if (!addressData[province]?.[city]?.[field.value]) {
                            error = "Select a valid suburb for the chosen city.";
                        }
                    } else if (field.id === "PostalCode") {
                        const province = provinceSelect.value;
                        const city = citySelect.value;
                        const suburb = suburbSelect.value;
                        const expected = addressData[province]?.[city]?.[suburb]?.street;

                        if (!expected || field.value !== expected) {
                            error = "Choose a suburb to populate its postal code.";
                        }
                    }

                    setFieldResult(field, error);
                    return !error;
                }

                window.validateAddressField = validateAddressField;
            });

            // =========================================================
            // PATIENT REGISTRATION VALIDATION AND DOB AUTO-POPULATION
            // =========================================================

            document.addEventListener("DOMContentLoaded", function() {
                const form = document.getElementById("registerForm");

                if (!form) return;

                const idField = document.getElementById("IDNumber");
                const dobField = document.getElementById("DateOfBirth");
                const fields = form.querySelectorAll("[data-validation]");

                function showResult(field, error) {
                    const container = field.closest(".mb-3");
                    const message = container
                        ? container.querySelector(".validation-message")
                        : null;

                    field.classList.toggle("is-invalid", Boolean(error));
                    field.classList.toggle(
                        "is-valid",
                        !error && field.value.trim() !== ""
                    );

                    if (message) {
                        message.textContent = error ||
                            (field.value.trim() ? "Looks good." : "");

                        message.classList.toggle("invalid", Boolean(error));
                        message.classList.toggle(
                            "valid",
                            !error && field.value.trim() !== ""
                        );
                    }
                }

                function isValidLuhn(id) {
                    let sum = 0;
                    let doubleDigit = false;

                    for (let i = id.length - 1; i >= 0; i--) {
                        let digit = Number(id[i]);

                        if (doubleDigit) {
                            digit *= 2;
                            if (digit > 9) digit -= 9;
                        }

                        sum += digit;
                        doubleDigit = !doubleDigit;
                    }

                    return sum % 10 === 0;
                }

                function getDateFromID(id) {
                    if (!/^\d{13}$/.test(id)) return null;

                    const yearPart = Number(id.substring(0, 2));
                    const month = Number(id.substring(2, 4));
                    const day = Number(id.substring(4, 6));

                    const currentYear = new Date().getFullYear() % 100;
                    const year = yearPart <= currentYear
                        ? 2000 + yearPart
                        : 1900 + yearPart;

                    const date = new Date(year, month - 1, day);
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);

                    if (
                        date.getFullYear() !== year ||
                        date.getMonth() !== month - 1 ||
                        date.getDate() !== day ||
                        date > today
                    ) {
                        return null;
                    }

                    return `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
                }

                function populateDateOfBirth() {
                    const id = idField.value.trim();

                    if (!/^\d{13}$/.test(id)) {
                        dobField.value = "";
                        showResult(dobField, "");
                        return;
                    }

                    const dateOfBirth = getDateFromID(id);

                    if (!dateOfBirth) {
                        dobField.value = "";
                        showResult(
                            dobField,
                            "The date encoded in this ID number is invalid."
                        );
                        return;
                    }

                    dobField.value = dateOfBirth;
                    showResult(dobField, "");
                }

                function validateField(field) {
                    const value = field.value.trim();
                    const type = field.dataset.validation;
                    let error = "";

                    if (type === "address" || type === "postal") {
                        if (typeof window.validateAddressField === "function") {
                            return window.validateAddressField(field);
                        }
                    }

                    if (!value) {
                        if (field.required) {
                            error = "This field is required.";
                        }

                        showResult(field, error);
                        return !error;
                    }

                    switch (type) {
                        case "name":
                            if (!/^[A-Za-zÀ-ÖØ-öø-ÿ' -]{2,100}$/.test(value)) {
                                error = "Enter at least 2 letters. Spaces, apostrophes and hyphens are allowed.";
                            }
                            break;

                        case "id":
                            if (!/^\d{13}$/.test(value)) {
                                error = "The ID number must contain exactly 13 digits.";
                            } else if (!getDateFromID(value)) {
                                error = "The date encoded in this ID number is invalid.";
                            } else if (!isValidLuhn(value)) {
                                error = "The ID number checksum is invalid. Please check the number.";
                            }
                            break;

                        case "dob": {
                            const expectedDate = getDateFromID(idField.value.trim());

                            if (!expectedDate) {
                                error = "Enter a valid 13-digit ID number first.";
                            } else if (value !== expectedDate) {
                                error = "Date of birth must match the date encoded in the ID number.";
                            }
                            break;
                        }

                        case "phone":
                            if (!/^(0[6-8]\d{8}|\+27[6-8]\d{8})$/.test(value)) {
                                error = "Enter a valid South African mobile number, e.g. 0821234567.";
                            }
                            break;

                        case "email": {
                            const atSymbol = String.fromCharCode(64);
                            const atIndex = value.indexOf(atSymbol);

                            if (
                                atIndex <= 0 ||
                                atIndex !== value.lastIndexOf(atSymbol) ||
                                atIndex === value.length - 1 ||
                                value.includes(" ") ||
                                !value.substring(atIndex + 1).includes(".") ||
                                value.substring(atIndex + 1).startsWith(".") ||
                                value.endsWith(".")
                            ) {
                                error = "Enter a valid email address.";
                            }
                            break;
                        }

                        case "required":
                            if (!value) {
                                error = "This field is required.";
                            }
                            break;
                    }

                    if (!error && field.validity.patternMismatch) {
                        error = "Please enter a value in the required format.";
                    }

                    showResult(field, error);
                    return !error;
                }

                // Populate Date of Birth when the ID is entered or pasted.
                idField.addEventListener("input", function() {
                    populateDateOfBirth();
                    validateField(idField);

                    if (dobField.value) {
                        validateField(dobField);
                    }
                });

                idField.addEventListener("change", function() {
                    populateDateOfBirth();
                    validateField(idField);

                    if (dobField.value) {
                        validateField(dobField);
                    }
                });

                fields.forEach(function(field) {
                    if (field.id === "IDNumber") return;

                    field.addEventListener("input", function() {
                        validateField(field);
                    });

                    field.addEventListener("change", function() {
                        validateField(field);
                    });

                    field.addEventListener("blur", function() {
                        validateField(field);
                    });
                });

                form.addEventListener("submit", function(event) {
                    populateDateOfBirth();

                    let allValid = true;

                    fields.forEach(function(field) {
                        if (!validateField(field)) {
                            allValid = false;
                        }
                    });

                    if (!allValid || !form.checkValidity()) {
                        event.preventDefault();
                        form.reportValidity();
                    }
                });
            });
    </script>


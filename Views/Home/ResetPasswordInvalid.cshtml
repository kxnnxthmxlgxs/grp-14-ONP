@{
    Layout = null;
    ViewData["Title"] = "Invalid Reset Link";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invalid Reset Link</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow p-4 text-center" style="max-width:450px">
            <h3>Reset Link Invalid or Expired</h3>

            <p class="mt-3">
                This password reset link is invalid or has expired.
                Please return to the login page and request a new link.
            </p>

            <a asp-controller="Home"
               asp-action="LoginPage"
               class="btn btn-primary">
                Return to Login
            </a>
        </div>
    </div>
</body>
</html>

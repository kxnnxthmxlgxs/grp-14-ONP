@model NMBDHL.Auth.Model.FirstLoginPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Update Your Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Update Your Password | NMBDHL</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            body {
                min-height: 100vh;
                margin: 0;
                background: #eef2f7;
                font-family: Arial, sans-serif;
            }

            .modal-content {
                border: 0;
                border-radius: 16px;
                box-shadow: 0 12px 40px rgba(0, 0, 0, .18);
            }

            .modal-header {
                padding: 24px 24px 12px;
                border-bottom: 0;
            }

            .modal-body {
                padding: 12px 24px 24px;
            }

            .modal-title {
                color: #203a5f;
                font-weight: 700;
            }

            .password-label {
                font-weight: 600;
                color: #27364b;
            }

            .form-control {
                padding: 12px;
                border-radius: 8px;
            }

            .btn-update {
                width: 100%;
                padding: 12px;
                border: 0;
                border-radius: 8px;
                background: #203a5f;
                color: white;
                font-weight: 600;
            }

                .btn-update:hover {
                    background: #162a46;
                    color: white;
                }

            .security-note {
                padding: 12px;
                margin-bottom: 20px;
                border-radius: 8px;
                background: #f0f5fb;
                color: #334e70;
                font-size: 14px;
            }
    </style>
</head>

<body>
    <div class="modal fade"
         id="firstLoginPasswordModal"
         tabindex="-1"
         aria-labelledby="firstLoginPasswordTitle"
         aria-modal="true"
         role="dialog"
         data-bs-backdrop="static"
         data-bs-keyboard="false">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <div>
                        <h4 class="modal-title"
                            id="firstLoginPasswordTitle">
                            Update Your Password
                        </h4>

                        <p class="text-muted mb-0 mt-2">
                            Welcome! Before continuing, please create a new password.
                        </p>
                    </div>
                </div>

                <div class="modal-body">

                    <div class="security-note">
                        <strong>Security requirement</strong>
                        <p class="mb-0 mt-1">
                            You are using a temporary password.
                            Please choose a new password to secure your account.
                        </p>
                    </div>

                    <form asp-controller="Home"
                          asp-action="ChangeFirstLoginPassword"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword"
                                   class="form-label password-label">
                                New Password
                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Enter your new password"
                                   required
                                   minlength="12"
                                   maxlength="128" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Use between 12 and 128 characters.
                            </small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword"
                                   class="form-label password-label">
                                Confirm New Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Re-enter your new password"
                                   required />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-update">
                            Update Password
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const modalElement =
                    document.getElementById("firstLoginPasswordModal");

                const modal = new bootstrap.Modal(modalElement, {
                    backdrop: "static",
                    keyboard: false
                });

                modal.show();
            });
    </script>
</body>
</html>